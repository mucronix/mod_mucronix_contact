<?xml version="1.0" encoding="UTF-8"?>
<!--
	Update server for mod_mucronix_contact.

	Served as a static file from https://mucronix.com/updates/mod_mucronix_contact.xml,
	outside Joomla routing: handing out updates must not depend on what becomes of the site.
	This file is not part of the installable package.

	Every element below is read by Joomla\CMS\Updater\Update and
	Joomla\CMS\Updater\Adapter\ExtensionAdapter. Two of them are easy to get wrong:

	- client: the string "site" or "administrator". A number still works, but only as
	  backwards compatibility with Joomla 1.6-3.10, said so in ExtensionAdapter itself.
	- targetplatform version: a regular expression, anchored at the front with ^ by the
	  parser. 6\.[0-9]+ covers the whole 6 branch and stops at 7.

	php_minimum is what makes the minimum PHP version reach a site at all: the installer
	never reads it from the extension manifest, only from here, and only when updating.
	The install script is what covers a first install.
-->
<updates>
	<update>
		<name>Mucronix Contact</name>
		<description>Contact form module for Joomla 6</description>
		<element>mod_mucronix_contact</element>
		<type>module</type>
		<client>site</client>
		<version>1.0.0</version>
		<infourl title="Mucronix Contact">https://github.com/mucronix/mod_mucronix_contact</infourl>
		<downloads>
			<downloadurl type="full" format="zip">https://github.com/mucronix/mod_mucronix_contact/releases/download/v1.0.0/mod_mucronix_contact-1.0.0.zip</downloadurl>
		</downloads>
		<changelogurl>https://github.com/mucronix/mod_mucronix_contact/releases</changelogurl>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer>Mucronix</maintainer>
		<maintainerurl>https://mucronix.com</maintainerurl>
		<targetplatform name="joomla" version="6\.[0-9]+"/>
		<php_minimum>8.3.0</php_minimum>
	</update>
</updates>
